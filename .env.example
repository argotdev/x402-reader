# The model behind `pnpm ask`. https://console.anthropic.com
ANTHROPIC_API_KEY=

# The publisher to read from. Any x402 publisher works for full URLs; the slug shortcut
# and the listing assume The Daily Agent's layout (/articles/<slug>.md, /articles.json).
SITE_URL=https://thedailyagent.news

# An EVM private key holding USDC on the publisher's network. Without it the reader stops
# at the 402 and prints the terms. Test USDC for Base Sepolia: https://faucet.circle.com
AGENT_PRIVATE_KEY=

# Baselayer Know Your Agent: lets the reader carry a credential and take free reads at publishers
# that recognise returning readers. A sandbox key works; the person is a fixture identity with fake
# details, created on first use. Without it the reader is anonymous and pays for everything.
BASELAYER_API_KEY=
# Who the agent acts for, and which signing key it uses. Two agents for one person share one reader.
PERSON=alice
AGENT_NAME=agent-a
